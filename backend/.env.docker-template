# # ENV
ENV=prod
APP_ENV=docker

# # PULL
BACKEND_IMAGE=ghcr.io/posdas/flashsale-backend:latest
GO_FETCHER_IMAGE=ghcr.io/posdas/flashsale-go-fetcher:latest
OZON_BROWSER_FETCHER_IMAGE=ghcr.io/posdas/flashsale-ozon-browser-fetcher:latest
WB_BROWSER_FETCHER_IMAGE=ghcr.io/posdas/flashsale-wb-browser-fetcher:latest
GRAFANA_IMAGE=ghcr.io/posdas/flashsale-grafana:latest
VPN_CONFIG_BUILDER_IMAGE=ghcr.io/posdas/flashsale-vpn-config-builder:latest

# # VPN
XRAY_PROXY_OUTBOUND_TAG=proxy
XRAY_LOG_LEVEL=warning

# # COMPOSE / PRODUCTION
DJANGO_ASGI_APP=app_project.asgi:application
BACKEND_WORKERS=2

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=super_strong_password
GRAFANA_SECRET_KEY=super_strong_secret_key

RABBITMQ_DEFAULT_USER=user
RABBITMQ_DEFAULT_PASS=super_strong_password

# # POSTGRES
# Администратор PostgreSQL — только для инициализации
POSTGRES_DB=flashsale
POSTGRES_USER=flashsale_admin
POSTGRES_PASSWORD=password

# Обычный пользователь приложения
POSTGRES_APP_USER=flashsale_app
POSTGRES_APP_PASSWORD=password

# Отдельный пользователь для postgres_exporter
POSTGRES_EXPORTER_USER=flashsale_exporter
POSTGRES_EXPORTER_PASSWORD=password

DATABASE_URL=postgresql://flashsale_app:password@postgres:5432/flashsale
DB_CONN_MAX_AGE=0

# # BACKEND
DEBUG=True
ENABLE_HTTPS_REDIRECT=False
SECRET_KEY=your-secret-key
ALLOWED_HOSTS=["0.0.0.0","127.0.0.1","localhost","backend","132.243.112.85"]
ALLOW_DB_CREATE=1
DJANGO_SETTINGS_MODULE=app_project.settings
OUTBOX_METRICS_PORT=9100
LOG_FORMAT=json

# # INFRA
GRAFANA_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
GRAFANA_TELEGRAM_CHAT_ID=your-chat-id

MONITORING_FETCHER_MODE=http
GO_FETCHER_BASE_URL=http://go_fetcher:8090
GO_FETCHER_PARSER_HEALTH_ENDPOINT=/api/v1/parser/health/
GO_FETCHER_PRODUCT_ENDPOINT=/api/v1/fetch/product/
GO_FETCHER_API_KEY=FETCHER_API_KEY=test-fetcher-key
FETCHER_API_KEY=test-fetcher-key
GO_FETCHER_TIMEOUT_SECONDS=60
GO_FETCHER_PARSER_HEALTH_TIMEOUT_SECONDS=270

MONITORING_SCANNER_BATCH_SIZE=50
MONITORING_SCANNER_SLEEP_SECONDS=30
MONITORING_SCANNER_METRICS_PORT=8012
MONITORING_SCANNER_OVERDUE_AFTER_SECONDS=300

# # NOTIFICATIONS
NOTIF_TELEGRAM_BOT_TOKEN=your-telegram-bot-token
NOTIF_TELEGRAM_BOT_USERNAME=bot_username_without_@

NOTIF_TELEGRAM_CONNECT_TOKEN_MAX_AGE_SECONDS=900
NOTIF_TELEGRAM_CONNECT_SIGNING_SALT='flashsale-notif-tg-connect-CHANGE-ME-LONG-RANDOM-VALUE'

# Общий лимит ответов бота
NOTIF_TELEGRAM_REPLY_RATE_LIMIT_LIMIT=5
NOTIF_TELEGRAM_REPLY_RATE_LIMIT_WINDOW_SECONDS=60

# Preview товара
NOTIF_TELEGRAM_PREVIEW_RATE_LIMIT_LIMIT=5
NOTIF_TELEGRAM_PREVIEW_RATE_LIMIT_WINDOW_SECONDS=300

# Ручная проверка товара
NOTIF_TELEGRAM_CHECK_NOW_RATE_LIMIT_LIMIT=3
NOTIF_TELEGRAM_CHECK_NOW_RATE_LIMIT_WINDOW_SECONDS=60

# Inline callback-кнопки
NOTIF_TELEGRAM_CALLBACK_RATE_LIMIT_LIMIT=30
NOTIF_TELEGRAM_CALLBACK_RATE_LIMIT_WINDOW_SECONDS=60

NOTIF_TELEGRAM_METRICS_PORT=8013

# Polling
NOTIF_TELEGRAM_DROP_PENDING_UPDATES_ON_START=False

# Pending product confirmation
NOTIF_TELEGRAM_PENDING_PRODUCT_TTL_SECONDS=600
NOTIF_TELEGRAM_PENDING_PRODUCT_LOCK_SECONDS=30

NOTIFICATION_CONSUMER_METRICS_PORT=8011
NOTIFICATION_RABBITMQ_QUEUE=flashsale.notifications
NOTIFICATION_RABBITMQ_DLQ=flashsale.notifications.dlq
NOTIFICATION_RABBITMQ_DLX=flashsale.notifications.dlx
NOTIFICATION_RABBITMQ_PREFETCH_COUNT=10
NOTIFICATION_RABBITMQ_ROUTING_KEYS=alert.created

NOTIFICATION_RABBITMQ_QUEUE_MAX_LENGTH=50000
NOTIFICATION_RABBITMQ_QUEUE_MAX_LENGTH_BYTES=268435456
NOTIFICATION_RABBITMQ_MESSAGE_TTL_MS=604800000

NOTIFICATION_RABBITMQ_DLQ_MAX_LENGTH=10000
NOTIFICATION_RABBITMQ_DLQ_MAX_LENGTH_BYTES=134217728
NOTIFICATION_RABBITMQ_DLQ_MESSAGE_TTL_MS=1209600000

# # RABBITMQ
OUTBOX_DISPATCH_MODE=rabbitmq  # local / rabbitmq
RABBITMQ_EXCHANGE=flashsale.events

RABBITMQ_DEFAULT_USER=flashsale
RABBITMQ_DEFAULT_PASS=CHANGE_ME_RANDOM_HEX_PASSWORD

RABBITMQ_URL=amqp://flashsale:CHANGE_ME_RANDOM_HEX_PASSWORD@rabbitmq:5672/%2F

# # REDIS / CELERY
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/1